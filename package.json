{
  "name": "traqu-desktop",
  "version": "1.5.0",
  "description": "A quiet, local-first roadmap workspace for Linux, Windows, and macOS.",
  "homepage": "https://github.com/Gurtejhundal/Traqu",
  "repository": {
    "type": "git",
    "url": "https://github.com/Gurtejhundal/Traqu.git"
  },
  "author": {
    "name": "Gurtejbir Singh",
    "email": "149035823+Gurtejhundal@users.noreply.github.com"
  },
  "private": true,
  "main": "desktop/main.cjs",
  "desktopName": "Traqu",
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  },
  "scripts": {
    "setup": "node scripts/setup.cjs",
    "build:frontend": "node scripts/build-frontend.cjs",
    "build:backend": "node scripts/build-backend.cjs",
    "start": "npm run build:frontend && electron .",
    "start:built": "electron .",
    "test": "node --test desktop/*.test.cjs",
    "test:desktop": "playwright test",
    "build": "npm run build:frontend && npm run build:backend",
    "dist": "npm run build && electron-builder --publish never",
    "pack": "npm run build && electron-builder --dir --publish never",
    "build:mobile": "node scripts/build-mobile.cjs",
    "sync:android": "npm run build:mobile && cap sync android",
    "test:mobile": "node --test frontend/src/mobile/*.test.js"
  },
  "devDependencies": {
    "@capacitor/android": "8.6.0",
    "@capacitor/cli": "8.6.0",
    "@capacitor/core": "8.6.0",
    "@playwright/test": "1.64.1",
    "electron": "45.2.1",
    "electron-builder": "26.18.0",
    "fake-indexeddb": "6.2.7"
  },
  "build": {
    "appId": "io.github.gurtejhundal.traqo",
    "productName": "Traqu",
    "copyright": "Copyright © 2026 Gurtej Hundal",
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "release",
      "buildResources": "desktop/resources"
    },
    "files": [
      "desktop/*.cjs",
      "desktop/*.mjs",
      "desktop/*.html",
      "desktop/resources/icon.png",
      "!desktop/*.test.cjs"
    ],
    "extraResources": [
      {
        "from": "dist/backend",
        "to": "backend",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "frontend/dist",
        "to": "frontend",
        "filter": [
          "**/*"
        ]
      }
    ],
    "artifactName": "Traqu-${version}-${os}-${arch}.${ext}",
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Office",
      "syncDesktopName": true,
      "icon": "desktop/resources/icon.png",
      "desktop": {
        "entry": {
          "StartupWMClass": "Traqu",
          "Comment": "Import plans. Track progress. Work locally."
        }
      },
      "artifactName": "Traqu-Linux-x64.${ext}"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "desktop/resources/icon.png",
      "artifactName": "Traqu-Windows-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.productivity",
      "icon": "desktop/resources/icon.png",
      "hardenedRuntime": true,
      "artifactName": "Traqu-macOS-${arch}.${ext}"
    },
    "deb": {
      "packageName": "traqo-desktop"
    }
  }
}
